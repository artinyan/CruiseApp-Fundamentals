@model CruiseApp.Web.ViewModels.Admin.AdminCruiseFormViewModel

@{
    ViewData["Title"] = "Create Cruise";
}

<div class="container page-container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
            <div class="card shadow-sm p-4">
                <h2 class="mb-4">@ViewData["Title"]</h2>

                <form asp-action="Create" method="post">
                    <!-- Покажи всички съобщения за грешки -->
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <!-- Ship -->
                    <div class="mb-3">
                        <label asp-for="ShipId" class="form-label"></label>
                        <select asp-for="ShipId" asp-items="ViewBag.Ships" class="form-select">
                            <option value="">-- Select Ship --</option>
                        </select>
                        <span asp-validation-for="ShipId" class="text-danger"></span>
                    </div>

                    <!-- First Day -->
                    <div class="mb-3">
                        <label asp-for="FirstDay" class="form-label"></label>
                        <input asp-for="FirstDay" class="form-control" type="date" />
                        <span asp-validation-for="FirstDay" class="text-danger"></span>
                    </div>

                    <!-- Last Day -->
                    <div class="mb-3">
                        <label asp-for="LastDay" class="form-label"></label>
                        <input asp-for="LastDay" class="form-control" type="date" />
                        <span asp-validation-for="LastDay" class="text-danger"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">Create</button>
                        <a asp-action="Index" class="btn btn-secondary flex-grow-1">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
