@model CruiseApp.Web.ViewModels.Admin.AdminCruiseListViewModel

<h1>Debug</h1>
<p>@(Model.GetType().FullName)</p>

@{
    ViewData["Title"] = "Delete Cruise";
}

<h2>Delete Cruise</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this cruise?
</div>

<dl class="row">
    <dt class="col-sm-2">Ship</dt>
    <dd class="col-sm-10">@Model.ShipName</dd>

    <dt class="col-sm-2">First Day</dt>
    <dd class="col-sm-10">@Model.FirstDay.ToShortDateString()</dd>

    <dt class="col-sm-2">Last Day</dt>
    <dd class="col-sm-10">@Model.LastDay.ToShortDateString()</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
