@model CruiseApp.Web.ViewModels.Admin.AdminCruiseFormViewModel

@{
    ViewData["Title"] = "Edit Cruise";
}

<h2>Edit Cruise</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Ship</label>
        <input class="form-control" value="@ViewBag.ShipName" disabled />
    </div>

    <div class="mb-3">
        <label asp-for="FirstDay" class="form-label"></label>
        <input asp-for="FirstDay" class="form-control" type="date" />
        <span asp-validation-for="FirstDay" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastDay" class="form-label"></label>
        <input asp-for="LastDay" class="form-control" type="date" />
        <span asp-validation-for="LastDay" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
