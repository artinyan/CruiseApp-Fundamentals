@model CruiseApp.ViewModels.Admin.AdminCruiseEditViewModel

@{
    ViewData["Title"] = "Edit Cruise";
}

<div class="container page-container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
            <div class="card shadow-sm p-4">
                <h2 class="mb-4">@ViewData["Title"]</h2>

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Ship</label>
                        <input class="form-control" value="@ViewBag.ShipName" disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FirstDay" class="form-label"></label>
                        <input asp-for="FirstDay" class="form-control" type="date" />
                        <span asp-validation-for="FirstDay" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LastDay" class="form-label"></label>
                        <input asp-for="LastDay" class="form-control" type="date" />
                        <span asp-validation-for="LastDay" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <h5 class="mt-4 mb-3">Cabin Prices</h5>

                    @for (int i = 0; i < Model.CabinPrices.Count; i++)
                    {
                        <div class="mb-3 row align-items-center">
                            <div class="col-6">
                                <label class="form-label">
                                    @Model.CabinPrices[i].CabinType
                                </label>
                                <input type="hidden"
                                       asp-for="CabinPrices[@i].CabinType" />
                            </div>

                            <div class="col-6">
                                <div class="input-group">
                                    <input asp-for="CabinPrices[@i].Price"
                                           class="form-control text-end"
                                           placeholder="0.00"
                                           step="0.01" />
                                    <span class="input-group-text">€</span>
                                </div>
                                <span asp-validation-for="CabinPrices[@i].Price"
                                      class="text-danger"></span>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">Save</button>
                        <a asp-action="Index" class="btn btn-secondary flex-grow-1">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $.validator.addMethod("daterange", function (value, element, params) {
            var start = $("#" + params.startpropertyname).val();
            if (!start || !value) return true;
            return value > start;
        });

        $.validator.unobtrusive.adapters.add("daterange", ["startpropertyname"], function (options) {
            options.rules["daterange"] = { startpropertyname: options.params.startpropertyname };
            options.messages["daterange"] = options.message;
        });
    </script>
}
