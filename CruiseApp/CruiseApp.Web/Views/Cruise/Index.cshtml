@using Microsoft.AspNetCore.Mvc.Rendering
@model CruiseApp.ViewModels.CruiseSearchViewModel

@{
    ViewData["Title"] = "Cruises";
}

<!-- ========================= -->
<!-- Hero section              -->
<!-- ========================= -->
<div class="container-fluid px-3 px-md-4 mb-4">
    <div class="hero-container">

        <img src="~/images/hero/hero1.jpg" class="hero-image active" />
        <img src="~/images/hero/hero2.jpg" class="hero-image" />
        <img src="~/images/hero/hero3.jpg" class="hero-image" />
    </div>
</div>

<!-- ========================= -->
<!-- Search form               -->
<!-- ========================= -->
<div class="page-container mb-4">
    <form method="get" asp-action="Index">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-3">


                <select asp-for="ShipId" class="form-select"
                        asp-items="@(Model.Ships.Select(s => new SelectListItem
                        {
                            Value = s.Value,
                            Text = s.Text
                        }))">
                    <option value="">-- All Ships --</option>
                </select>
            </div>

            <div class="col-12 col-md-6 col-lg-3">


                <select asp-for="StartPointId" class="form-select"
                        asp-items="@(Model.StartPoints.Select(s => new SelectListItem
                        {
                            Value = s.Value,
                            Text = s.Text
                        }))">
                    <option value="">-- All Ports --</option>
                </select>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="StartDate" class="form-label">Start Date</label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <button type="submit" class="btn btn-primary w-100">
                    Search
                </button>
            </div>
        </div>
    </form>
</div>

<!-- ========================= -->
<!-- Cruises list              -->
<!-- ========================= -->
@if (Model.Cruises != null && Model.Cruises.Any())
{
    <div class="page-container mb-5">
        <div class="cruise-list">
            @foreach (var cruise in Model.Cruises)
            {
                <partial name="_CruiseCardPartial" model="cruise" />
            }
        </div>
    </div>
}
else
{
    <p class="text-muted">No cruises found for the selected criteria.</p>
}

<script>
    const images = document.querySelectorAll('.hero-image');
    let currentIndex = 0;

    setInterval(() => {
        images[currentIndex].classList.remove('active');
        currentIndex = (currentIndex + 1) % images.length;
        images[currentIndex].classList.add('active');
    }, 10000);
</script>
