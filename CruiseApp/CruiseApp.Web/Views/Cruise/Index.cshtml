@model CruiseApp.Web.ViewModels.CruiseSearchViewModel

@{
    ViewData["Title"] = "Cruises";
}

<!-- ========================= -->
<!-- Hero section              -->
<!-- ========================= -->
<div class="hero-container">
    <img src="~/images/hero/hero1.jpg" class="hero-image active" />
    <img src="~/images/hero/hero2.jpg" class="hero-image" />
    <img src="~/images/hero/hero3.jpg" class="hero-image" />
</div>

<!-- ========================= -->
<!-- Search form               -->
<!-- ========================= -->
<form method="get" asp-action="Index" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label asp-for="ShipId" class="form-label">Ship</label>
            <select asp-for="ShipId" class="form-select" asp-items="Model.Ships">
                <option value="">-- All Ships --</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="StartPointId" class="form-label">Start Point</label>
            <select asp-for="StartPointId" class="form-select" asp-items="Model.StartPoints">
                <option value="">-- All Ports --</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="StartDate" class="form-label">Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">
                Search
            </button>
        </div>
    </div>
</form>

<hr />

<!-- ========================= -->
<!-- Cruises list              -->
<!-- ========================= -->
@if (Model.Cruises != null && Model.Cruises.Any())
{
    <div class="cruise-list">
        @foreach (var cruise in Model.Cruises)
        {
            <partial name="_CruiseCardPartial" model="cruise" />
        }
    </div>
}
else
{
    <p class="text-muted">No cruises found for the selected criteria.</p>
}

<script>
    const images = document.querySelectorAll('.hero-image');
    let currentIndex = 0;

    setInterval(() => {
        images[currentIndex].classList.remove('active');
        currentIndex = (currentIndex + 1) % images.length;
        images[currentIndex].classList.add('active');
    }, 10000);
</script>


