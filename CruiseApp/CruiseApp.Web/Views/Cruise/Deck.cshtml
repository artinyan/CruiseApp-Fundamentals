@model CruiseApp.Web.ViewModels.Cruise.DeckCabinsViewModel
@{
    ViewData["Title"] = "Deck Details";
}

<div class="page-container mb-5">
    <a asp-action="Cabins"
       asp-route-cruiseId="@Model.CruiseId"
       class="btn btn-link px-0 mb-3">
        ← Back to View Cabins
    </a>
    <h2 class="mb-4">
        Select @Model.CabinType Cabin on Deck @Model.DeckNumber
    </h2>
</div>

<div class="deck-map">
    <img src="~/images/decks/@Model.DeckImage" />

    @foreach (var cabin in Model.Cabins)
    {
        if (cabin.IsAvailable)
        {
            <a class="cabin cabin-blue"
               style="left:@(cabin.PosX)px; top:@(cabin.PosY)px">
                @cabin.Name
            </a>

        }
        else
        {
            <a class="cabin cabin-unavailable"
               style="left:@(cabin.PosX)px; top:@(cabin.PosY)px">
                @cabin.Name
            </a>
        }
    }
</div>