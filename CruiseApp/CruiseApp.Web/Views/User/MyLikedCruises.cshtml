@using CruiseApp.Web.ViewModels
@model IEnumerable<CruiseListItemViewModel>

@{
    ViewData["Title"] = "My Liked Cruises";
}

<!-- ========================= -->
<!-- Hero section              -->
<!-- ========================= -->
<div class="page-container mb-4">
    <div class="hero-container">
        <img src="~/images/hero/hero1.jpg" class="hero-image active" />
        <img src="~/images/hero/hero2.jpg" class="hero-image" />
        <img src="~/images/hero/hero3.jpg" class="hero-image" />
    </div>
</div>

<div class="page-container">
    <h2 class="mb-4">❤️ My Liked Cruises</h2>

    @if (!Model.Any())
    {
        <p class="text-muted">You haven’t liked any cruises yet.</p>
    }
    else
    {
        <div class="cruise-list">
            @foreach (var cruise in Model)
            {
                <partial name="_CruiseCardPartial" model="cruise" />
            }
        </div>
    }
</div>

<!-- Hero Image Carousel Script -->
<script>
    const images = document.querySelectorAll('.hero-image');
    let currentIndex = 0;

    setInterval(() => {
        images[currentIndex].classList.remove('active');
        currentIndex = (currentIndex + 1) % images.length;
        images[currentIndex].classList.add('active');
    }, 10000);
</script>
