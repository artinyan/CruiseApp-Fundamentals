@model CruiseApp.ViewModels.Cruise.DeckCabinsViewModel
@{
    ViewData["Title"] = "Deck Details";
}

<div class="page-container mb-5">
    <a asp-action="Cabins"
       asp-route-cruiseId="@Model.CruiseId"
       class="btn btn-link px-0 mb-3">
        ← Back to View Cabins
    </a>
    @if (User.IsInRole("Administrator"))
    {
    <h2 class="mb-4">
        @Model.CabinType Cabin on Deck @Model.DeckNumber. <strong>Administrator can not do booking.</strong>
    </h2>
    }
    else
    {
    <h2 class="mb-4">
        Select @Model.CabinType Cabin on Deck @Model.DeckNumber
    </h2>
    }
</div>

<div class="deck-map">
    <img src="~/images/decks/@Model.DeckImage" />

    @foreach (var cabin in Model.Cabins)
    {
        @if (cabin.IsAvailable)
        {
            if (User.IsInRole("Administrator"))
            {
                <span class="cabin cabin-blue"
                      style="left:@(cabin.PosX)px; top:@(cabin.PosY)px; cursor:not-allowed;"
                      title="Admins cannot make reservations">
                    @cabin.Name
                </span>
            }
            else
            {
                <a asp-controller="Reservation"
                       asp-action="Create"
                       asp-route-cabinId="@cabin.Id"
                       asp-route-cruiseId="@Model.CruiseId"
                       class="cabin cabin-blue"
                       style="left:@(cabin.PosX)px; top:@(cabin.PosY)px">
                    @cabin.Name
                </a>
            }
        }
        else
        {
            <span class="cabin cabin-unavailable"
                  style="left:@(cabin.PosX)px; top:@(cabin.PosY)px">
                @cabin.Name
            </span>
        }
    }
</div>