@using CruiseApp.ViewModels.Admin
@model IEnumerable<AdminCruiseListViewModel>

@{
    ViewData["Title"] = "Admin Cruise";
}

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container page-container mt-4">
    <div class="card shadow-sm p-4">
        <h1 class="mb-4">Admin – Cruises</h1>

        <a asp-area="Admin" asp-controller="Cruise" asp-action="Create" class="btn btn-success mb-3">
            ➕ Add Cruise
        </a>

        <!-- ===== DESKTOP / TABLET TABLE ===== -->
        <div class="table-responsive d-none d-md-block">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Ship</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Nights</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.ShipName</td>
                            <td>@c.FirstDay.ToShortDateString()</td>
                            <td>@c.LastDay.ToShortDateString()</td>
                            <td>@c.CruiseLength</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-warning btn-sm">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-danger btn-sm">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ===== MOBILE CARDS ===== -->
        <div class="d-md-none">
            @foreach (var c in Model)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-2">@c.ShipName</h5>

                        <div class="row small">
                            <div class="col-6">
                                <span class="text-muted">From</span><br />
                                @c.FirstDay.ToShortDateString()
                            </div>
                            <div class="col-6">
                                <span class="text-muted">To</span><br />
                                @c.LastDay.ToShortDateString()
                            </div>
                            <div class="col-12 mt-2">
                                <span class="text-muted">Nights</span><br />
                                @c.CruiseLength
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="Edit" asp-route-id="@c.Id"
                               class="btn btn-warning btn-sm w-50">Edit</a>
                            <a asp-action="Delete" asp-route-id="@c.Id"
                               class="btn btn-danger btn-sm w-50">Delete</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
